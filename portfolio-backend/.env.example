# Copie para ".env" e preencha com valores reais. Nunca commitar o ".env".

SECRET_KEY=troque-por-uma-chave-secreta-gerada
DATABASE_URL=postgres://usuario:senha@localhost:5432/portfolio_leads

# Domínios do frontend autorizados a chamar a API (separados por vírgula).
# Ex.: https://seu-portfolio.vercel.app,https://seudominio.com
CORS_ALLOWED_ORIGINS=https://seu-portfolio.com

# Apenas para settings/prod.py.
# ALLOWED_HOSTS: host(s) que servem o Django (sem esquema) — ex. domínio
# gerado pelo Koyeb ou seu domínio próprio.
ALLOWED_HOSTS=seu-backend.koyeb.app

# CSRF_TRUSTED_ORIGINS: mesmos domínios de ALLOWED_HOSTS, mas com esquema
# https:// — exigido pelo Django para validar POSTs do /dashboard/ atrás
# do proxy do Koyeb.
CSRF_TRUSTED_ORIGINS=https://seu-backend.koyeb.app
